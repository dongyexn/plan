{
  "name": "hservice-calendar-widget",
  "version": "1.0.1",
  "description": "H서비스센터 업무 일정 데스크톱 위젯",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:zip": "electron-builder --win zip",
    "dist:nosign": "electron-builder --win portable -c.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "kr.co.hdec.hservice.calwidget",
    "productName": "업무일정위젯",
    "files": [
      "main.js",
      "desktop-pin.js",
      "package.json",
      "tray.png",
      "icon.png",
      "node_modules/koffi/**/*",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/build/koffi/darwin_*",
      "!node_modules/koffi/build/koffi/linux_*",
      "!node_modules/koffi/build/koffi/freebsd_*",
      "!node_modules/koffi/build/koffi/openbsd_*",
      "!node_modules/koffi/build/koffi/win32_arm64",
      "!node_modules/koffi/build/koffi/win32_ia32"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "HPlanWidget.exe"
    },
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "koffi": "^2.8.0"
  },
  "author": "H서비스중부팀"
}
