{
  // ===================================================================
  // H서비스센터 — Firebase Realtime Database 보안 규칙 (report-c29a1)
  //
  // 단일 앱 체제(622차) — 별도 앱이던 '하자처리 현황'은 주요업무 현황(calapp)으로
  // 통합·폐기되었다. 아래 최상위 노드는 전부 calapp 하나가 쓴다.
  //   · 하자 관리 : users · report · reportIndex · plans · analysis · meta · siteConfig
  //   · 업무 관리 : calapp/*
  // 폐기 정리: aiRules(규칙 편집 기능 폐지 — 규칙은 코드 내 RULE_DEF/CRIT_DEF 고정),
  //   calapp/mentions(멘션 기능 제거) 블록 삭제. 잔존 데이터는 콘솔에서만 접근된다.
  //   복원이 필요하면 report 저장소 최종본(report-final)의 규칙을 참조.
  //
  // 권한 모델(공통)
  //   - 접근 자격(VERIF): 로그인 + 이메일 인증 완료 + @hdec.co.kr 도메인
  //   - 역할(users/{uid}/role): editor(관리자) / viewer(사용자) / blocked(차단)
  //   - MEMBER = VERIF 이고 role 이 editor 또는 viewer (blocked·미등록 제외)
  //   - EDITOR = VERIF 이고 role 이 editor
  //   - 최초 관리자는 콘솔에서 users/{uid}/role="editor" 로 1회 부트스트랩.
  //
  // 주요업무 현황(calapp) 경로별 권한
  //   calapp/plans/{YYYY-MM}/{id} : MEMBER 읽기·쓰기 — 단발 일정(기간 포함)
  //   calapp/recur/{id}           : MEMBER 읽기·쓰기 — 반복 일정 원본
  //   calapp/tasks/{sid}/{iid}    : MEMBER 읽기·쓰기 — 주요업무 항목(+코멘트)
  //   calapp/people/{uid}         : MEMBER 읽기·쓰기 — 팀·권역·현장 배정 명부
  //   calapp/org                  : MEMBER 읽기·쓰기 — 팀·권역·현장 목록
  //   calapp/cfg                  : MEMBER 읽기 / EDITOR 쓰기 — 메일·연결 설정
  //
  //   ※ users 목록 읽기는 MEMBER 에 열려 있다(조직 관리의 계정 목록).
  //     단 role 쓰기는 여전히 EDITOR 전용 — 자기 권한 상승·타인 권한 변경 불가.
  // ===================================================================
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      // 목록 전체 읽기는 MEMBER — 조직 관리의 계정 목록은 사용자도 본다(권한 변경은 관리자만)
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
      "$uid": {
        // 본인 레코드는 본인이, 그 외에는 MEMBER 가 읽을 수 있음
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')))",
        // 쓰기: ① 본인이면 (최초 등록 시에만) role을 viewer로 생성 / 등록 이후엔 기존 role 유지만 가능
        //         (자기 권한 상승 차단 + blocked 계정이 스스로 viewer로 되돌리는 자가해제 차단)
        //         + email 은 본인 토큰 이메일과 일치해야 함(타인 이메일 기재 레코드 생성·변조 차단)
        //           클라이언트가 가입·기록 시 이메일을 소문자로 정규화하므로 토큰 이메일과 대소문자 일치.
        //           ※ 이 조건 때문에 부분 쓰기(lastSeen·name 단독)는 거부된다 — 클라이언트는 레코드 전체를 set 한다.
        //       ② 또는 관리자면 누구든 변경 가능
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && ( (auth.uid == $uid && newData.child('email').val() == auth.token.email && ( (!data.exists() && newData.child('role').val() == 'viewer') || (data.exists() && newData.child('role').val() == data.child('role').val()) )) || root.child('users').child(auth.uid).child('role').val() == 'editor' )",
        // 레코드에는 최소 email·role 이 있어야 함(역할 없는 레코드 생성 차단)
        ".validate": "newData.hasChildren(['email','role'])",
        "email":     { ".validate": "newData.isString() && newData.val().length <= 200" },
        "role":      { ".validate": "newData.isString() && (newData.val() == 'editor' || newData.val() == 'viewer' || newData.val() == 'blocked')" },
        "name":      { ".validate": "newData.isString() && newData.val().length <= 60" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "lastSeen":  { ".validate": "newData.isNumber()" },
        "avColor":   { ".validate": "newData.isString() && newData.val().length <= 16" },
        "avIcon":    { ".validate": "newData.isString() && newData.val().length <= 24" },
        "$other":    { ".validate": false }
      }
    },

    "report": {
      // 게시 집계 읽기: 모든 MEMBER (뷰어는 최신 기준월을 limitToLast로 조회)
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
      "$rm": {
        // 게시(쓰기)는 관리자만
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && root.child('users').child(auth.uid).child('role').val() == 'editor'",
        ".validate": "$rm.matches(/^[0-9]{4}-[0-9]{2}$/)"
      }
    },

    "reportIndex": {
      // 게시월 인덱스: 기준월 선택기·위젯 새 게시월 신호가 이 노드만 읽어 목록을 구성
      // (report 전체 다운로드 방지). 게시(dfPublish) 시 reportIndex/{rm}=Date.now() 로 관리자가 기록.
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
      "$rm": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && root.child('users').child(auth.uid).child('role').val() == 'editor'",
        ".validate": "$rm.matches(/^[0-9]{4}-[0-9]{2}$/) && newData.isNumber()"
      }
    },

    "plans": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
      "$sid": {
        "$field": {
          "$key": {
            // 처리계획 리프 쓰기: MEMBER, 허용된 3개 필드만, 문자열 ≤5000자
            ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer') && ($field == 'processingPlan' || $field == 'vacantProcessingPlan' || $field == 'commercialProcessingPlan')",
            ".validate": "newData.isString() && newData.val().length <= 5000"
          }
        }
      }
    },

    "analysis": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
      "$sid": {
        // 분석의견은 기준월별 아카이브: analysis/{sid}/{YYYY-MM} = HTML 문자열 ≤20000자.
        // 쓰기는 월 노드에만 허용 — 구버전 형태(analysis/{sid} = 문자열) 직접 쓰기는 거부된다.
        // 레거시 문자열 데이터는 읽기 시 수용된다(dfAitHTML 의 typeof 분기).
        "$rm": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
          ".validate": "$rm.matches(/^[0-9]{4}-[0-9]{2}$/) && newData.isString() && newData.val().length <= 20000"
        }
      }
    },

    "meta": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
      "$sid": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
        "updatedAt": { ".validate": "newData.isNumber()" },
        "updatedBy": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other":    { ".validate": false }
      }
    },

    "siteConfig": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
      "$sid": {
        // 현장 토글 쓰기: 관리자만
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && root.child('users').child(auth.uid).child('role').val() == 'editor'",
        "hasCommercial": { ".validate": "newData.isBoolean()" },
        "showVacant":    { ".validate": "newData.isBoolean()" },
        "updatedAt":     { ".validate": "newData.isNumber()" },
        "$other":        { ".validate": false }
      }
    },

    // ===================================================================
    // 주요업무 현황 앱 (일정 달력 + 주요업무 현황)
    //   읽기는 MEMBER 전체. 쓰기는 두 단계로 나눈다.
    //     · 일정·업무 : MEMBER 누구나 (협업 도구이므로 사용자도 작성 가능)
    //     · 설정(cfg)·휴무일 : EDITOR 만
    // ===================================================================
    "calapp": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",

      // 단발 일정 — calapp/plans/{YYYY-MM}/{id}
      "plans": {
        "$ym": {
          ".validate": "$ym.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "$id": {
            ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
            ".validate": "!newData.exists() || newData.hasChildren(['id','date','title'])",
            "id":        { ".validate": "newData.isString() && newData.val().length <= 40" },
            "date":      { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "end":       { ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
            "title":     { ".validate": "newData.isString() && newData.val().length <= 120" },
            "time":      { ".validate": "newData.isString() && newData.val().length <= 5" },
            "endTime":   { ".validate": "newData.isString() && newData.val().length <= 5" },
            "site":      { ".validate": "newData.isString() && newData.val().length <= 40" },
            "body":      { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "color":     { ".validate": "newData.isString() && newData.val().length <= 16" },
            "owner":     { ".validate": "newData.isString() && newData.val().length <= 60" },
            "owners":    { "$pid": { ".validate": "newData.isNumber()" } },
            "by":        { ".validate": "newData.isString() && newData.val().length <= 60" },
            "remind":    { ".validate": "newData.isBoolean()" },
            "done":      { ".validate": "newData.isBoolean()" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "recur": {
              "f":     { ".validate": "newData.isString() && (newData.val() == '' || newData.val() == 'w' || newData.val() == '2w' || newData.val() == 'm' || newData.val() == 'y')" },
              "until": { ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
              "$other": { ".validate": false }
            },
            "$other":    { ".validate": false }
          }
        }
      },

      // 반복 일정 원본 — 월 경계와 무관하므로 별도 노드에 둔다
      "recur": {
        "$id": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
          ".validate": "!newData.exists() || newData.hasChildren(['id','date','title'])",
          "id":        { ".validate": "newData.isString() && newData.val().length <= 40" },
          "date":      { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "end":       { ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
          "title":     { ".validate": "newData.isString() && newData.val().length <= 120" },
          "time":      { ".validate": "newData.isString() && newData.val().length <= 5" },
          "endTime":   { ".validate": "newData.isString() && newData.val().length <= 5" },
          "site":      { ".validate": "newData.isString() && newData.val().length <= 40" },
          "body":      { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "color":     { ".validate": "newData.isString() && newData.val().length <= 16" },
          "owner":     { ".validate": "newData.isString() && newData.val().length <= 60" },
          "owners":    { "$pid": { ".validate": "newData.isNumber()" } },
          "by":        { ".validate": "newData.isString() && newData.val().length <= 60" },
          "remind":    { ".validate": "newData.isBoolean()" },
          "done":      { ".validate": "newData.isBoolean()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "recur": {
            "f":     { ".validate": "newData.isString() && (newData.val() == 'w' || newData.val() == '2w' || newData.val() == 'm' || newData.val() == 'y')" },
            "until": { ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
            "$other": { ".validate": false }
          },
          // 회차별 완료 표시 / 제외 날짜 — {"2026-07-29": 1}
          "doneOn": { "$d": { ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber()" } },
          "skipOn": { "$d": { ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber()" } },
          "moveOn": { "$d": { ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" } },
          "$other": { ".validate": false }
        }
      },

      // 주요업무 항목 — subjectId 는 팀 id 또는 담당자 id
      "tasks": {
        "$sid": {
          "$iid": {
            ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
            "text":      { ".validate": "newData.isString() && newData.val().length <= 500" },
            "body":      { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "prog":      { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "date":      { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "end":       { ".validate": "newData.isString() && newData.val().length <= 10" },
            "time":      { ".validate": "newData.isString() && newData.val().length <= 5" },
            "endTime":   { ".validate": "newData.isString() && newData.val().length <= 5" },
            "remind":    { ".validate": "newData.isBoolean()" },
            "recur": {
              "f":     { ".validate": "newData.isString() && newData.val().length <= 3" },
              "until": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "$o":    { ".validate": false }
            },
            "doneOn": { "$d": { ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber()" } },
            "skipOn": { "$d": { ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber()" } },
            "moveOn": { "$d": { ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" } },
            "color":     { ".validate": "newData.isString() && newData.val().length <= 16" },
            "plan":      { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "site":      { ".validate": "newData.isString() && newData.val().length <= 40" },
            "kind":      { ".validate": "newData.isString() && newData.val().length <= 10" },
            "order":     { ".validate": "newData.isNumber()" },
            "assignees": { "$pid": { ".validate": "newData.isNumber()" } },
            "links": {
              "$lid": {
                "url":   { ".validate": "newData.isString() && newData.val().length <= 2000 && newData.val().matches(/^https?:[/][/]/)" },
                "label": { ".validate": "newData.isString() && newData.val().length <= 80" },
                "$other": { ".validate": false }
              }
            },
            "st":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "stKeep":    { ".validate": "newData.isBoolean()" },
            "due":       { ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "comments": {
              "$cid": {
                "by":   { ".validate": "newData.isString() && newData.val().length <= 60" },
                "text": { ".validate": "newData.isString() && newData.val().length <= 500" },
                "at":   { ".validate": "newData.isNumber()" },
                "uid":  { ".validate": "newData.isString() && newData.val().length <= 60" },
                "re":   { ".validate": "newData.isString() && newData.val().length <= 40" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        }
      },

      // 휴지통(383차) — 삭제한 업무를 30일 보관. 원본은 z(lz 압축)로 통째 넣고
      // text·date 는 목록 표시용. 복원 시 cleanTask 를 다시 지나 tasks 스키마로 검증되므로
      // 여기서는 필드 검증을 반복하지 않는다(필드가 늘어도 이 블록은 그대로).
      "trash": {
        "$sid": {
          "$iid": {
            ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
            "text":      { ".validate": "newData.isString() && newData.val().length <= 500" },
            "date":      { ".validate": "newData.isString() && newData.val().length <= 10" },
            "deletedAt": { ".validate": "newData.isNumber()" },
            "z":         { ".validate": "newData.isString() && newData.val().length <= 60000" },
            "$other":    { ".validate": false }
          }
        }
      },

      // 아카이브(384차) — 완료·종료 후 6개월 지난 업무를 실시간 구독 밖으로 옮겨 둔다.
      // 모양은 trash 와 같다(z 압축 + 표시용 평문). 필요할 때만 통째로 한 번 읽는다.
      "archive": {
        "$sid": {
          "$iid": {
            ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
            "text":       { ".validate": "newData.isString() && newData.val().length <= 500" },
            "date":       { ".validate": "newData.isString() && newData.val().length <= 10" },
            "archivedAt": { ".validate": "newData.isNumber()" },
            "z":          { ".validate": "newData.isString() && newData.val().length <= 60000" },
            "$other":     { ".validate": false }
          }
        }
      },

      // 팀·권역·현장 목록 — MEMBER 변경 가능
      "org": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
        "teams": {
          "$i": {
            "id":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "$other": { ".validate": false }
          }
        },
        "regions": {
          "$i": {
            "id":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "$other": { ".validate": false }
          }
        },
        "sites": {
          "$i": {
            "id":     { ".validate": "newData.isString() && newData.val().length <= 40" },
            "name":   { ".validate": "newData.isString() && newData.val().length <= 60" },
            "team":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "region": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "units":           { ".validate": "newData.isNumber()" },
            "buildings":       { ".validate": "newData.isNumber()" },
            "commercialUnits": { ".validate": "newData.isNumber()" },
            "completionDate":  { ".validate": "newData.isString() && newData.val().length <= 10" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      },

      // 담당자 명부(팀·권역·현장 배정) — MEMBER 변경 가능
      "people": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && (root.child('users').child(auth.uid).child('role').val() == 'editor' || root.child('users').child(auth.uid).child('role').val() == 'viewer')",
        "$pid": {
          "name":   { ".validate": "newData.isString() && newData.val().length <= 60" },
          "email":  { ".validate": "newData.isString() && newData.val().length <= 200" },
          "team":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "region": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "rank":   { ".validate": "newData.isString() && (newData.val() == 'member' || newData.val() == 'lead' || newData.val() == 'head' || newData.val() == 'safety' || newData.val() == 'cost')" },
          "sites":  { "$sid": { ".validate": "newData.isNumber()" } },
          "$other": { ".validate": false }
        }
      },

      // 개인 설정(저장한 필터 등) — 본인 것만 쓰기, 읽기는 상위 calapp 규칙(MEMBER)
      "prefs": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/)",
          "emoji": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "favs": {
            "$fid": {
              "name":  { ".validate": "newData.isString() && newData.val().length <= 40" },
              "reg":   { ".validate": "newData.isString() && newData.val().length <= 60" },
              "own":   { ".validate": "newData.isString() && newData.val().length <= 60" },
              "view":  { ".validate": "newData.isString() && (newData.val() == 'dayGridMonth' || newData.val() == 'timeGridWeek')" },
              "at":    { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },

      // 팀 휴무일(단체연차 등) — 날짜별 이름 한 줄. 관리자만 지정
      "offdays": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && root.child('users').child(auth.uid).child('role').val() == 'editor'",
        "$date": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12 && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" }
      },

      // 앱 설정(바로가기 주소 등) — 관리자만 변경
      "cfg": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@hdec[.]co[.]kr$/) && root.child('users').child(auth.uid).child('role').val() == 'editor'",
        "defectUrl": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "widgetUrl": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "orgSrc":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "dfHide": {
          "$sid": { ".validate": "newData.isBoolean()" }
        },
        "siteAddr": {
          "$sid": { ".validate": "newData.isString() && newData.val().length <= 120" }
        },
        "$other":    { ".validate": false }
      },

      "$other": { ".validate": false }
    }
  }
}
