{
  "_안내": "기존 database.rules.json의 rules 아래에 calapp 블록을 추가하세요. 원칙: 이메일 인증된 @hdec.co.kr 계정 + 차단(blocked) 아님 → 읽기. 쓰기는 두 단계로 나눕니다 — 일정·업무는 모든 인증 사용자, 팀·권역·계정배정·설정은 관리자(editor)만.",
  "_users_읽기": "설정의 계정 목록은 하자처리 현황과 공용인 users 노드를 읽습니다. 기존 규칙에서 users 읽기가 관리자 전용이면 그대로 두어도 앱은 동작하며(설정에서 담당자 직접 추가로 대체), 모든 팀원에게 목록을 보이려면 users의 '.read'를 아래 calapp과 같은 조건으로 완화하세요.",
  "calapp": {
    ".read": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@hdec.co.kr') && root.child('users').child(auth.uid).child('role').val() != 'blocked'",
    "plans": {
      "$ym": {
        "$id": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@hdec.co.kr') && root.child('users').child(auth.uid).child('role').val() != 'blocked'",
          ".validate": "!newData.exists() || (newData.hasChildren(['id','date','title']) && newData.child('title').isString() && newData.child('title').val().length <= 120 && newData.child('date').isString() && newData.child('date').val().length == 10 && newData.child('body').val().length <= 1000)"
        }
      }
    },
    "recur": {
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@hdec.co.kr') && root.child('users').child(auth.uid).child('role').val() != 'blocked'",
        ".validate": "!newData.exists() || (newData.hasChildren(['id','date','title']) && newData.child('title').val().length <= 120 && newData.child('date').val().length == 10)"
      }
    },
    "tasks": {
      "$sid": {
        "$iid": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@hdec.co.kr') && root.child('users').child(auth.uid).child('role').val() != 'blocked'",
          ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 500 && (!newData.child('st').exists() || (newData.child('st').isNumber() && newData.child('st').val() >= 0 && newData.child('st').val() <= 3)))",
          "comments": {
            "$cid": {
              ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 500)"
            }
          }
        }
      }
    },
    "org": {
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@hdec.co.kr') && root.child('users').child(auth.uid).child('role').val() === 'editor'"
    },
    "people": {
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@hdec.co.kr') && root.child('users').child(auth.uid).child('role').val() === 'editor'"
    },
    "cfg": {
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@hdec.co.kr') && root.child('users').child(auth.uid).child('role').val() === 'editor'"
    }
  }
}